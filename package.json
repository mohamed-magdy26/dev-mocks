{
  "name": "@dsquares/dev-mocks",
  "version": "0.2.0",
  "description": "Dev-only panel that makes chosen API requests fail, for React apps. Built on MSW.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dev-mocks": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:css && tsc -p tsconfig.json",
    "typecheck": "npm run build:css && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "msw": "^2.8.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "msw": "^2.15.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@babel/parser": "^7.29.11",
    "clsx": "^2.1.1"
  }
}
